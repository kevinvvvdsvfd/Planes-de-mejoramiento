  estado.periodo = null;
  renderGrados();
  mostrar('grado');
}

function renderGrados(){
  const grid = document.getElementById('grid-grados');
  const datos = PLANES[estado.materia];
  document.getElementById('grado-subtitulo').textContent =
    `Área de ${datos.nombre} · Selecciona el grado al que perteneces`;

  const grados = Object.keys(datos.grados).sort((a,b) => parseInt(a) - parseInt(b));
  grid.innerHTML = '';
  grados.forEach(g => {
    const btn = document.createElement('div');
    btn.className = 'btn-grado';
    btn.innerHTML = `${g}°<span class="sub">${gradoEnLetras(g)}</span>`;
    btn.onclick = () => seleccionarGrado(g);
    grid.appendChild(btn);
  });
}

function gradoEnLetras(g){
  const nombres = {
    "6":"Sexto","7":"Séptimo","8":"Octavo","9":"Noveno",
    "10":"Décimo","11":"Undécimo"
  };
  return nombres[g] || `Grado ${g}`;
}

function seleccionarGrado(grado){
  estado.grado = grado;
  estado.periodo = null;
  document.getElementById('periodo-subtitulo').textContent =
    `Grado ${grado}° · ${PLANES[estado.materia].nombre} · Selecciona el periodo`;
  mostrar('periodo');
}

function seleccionarPeriodo(periodo){
  estado.periodo = periodo;
  renderPlan();
  mostrar('plan');
}

/* =====================================================================
   BLOQUE DE NIVELACIÓN – EXPOSICIÓN DE 10 MINUTOS
   Se inserta automáticamente en TODOS los planes (todos los grados,
   áreas y periodos) al momento de renderizarlos.
   ===================================================================== */
function construirBloqueNivelacion(periodo){
  const tercero = String(periodo) === '3';

  const fecha = tercero
    ? `<div class="fecha-limite">
         📅 <strong>FECHA LÍMITE – TERCER PERIODO:</strong> la <strong>exposición</strong> y el <strong>trabajo escrito</strong> deben realizarse <strong>ANTES DEL 25 DE OCTUBRE</strong>. Si no se realizan antes de esta fecha, <strong>NO SE NIVELA LA MATERIA</strong>.
       </div>`
    : `<div class="fecha-limite">
         📅 <strong>FECHA LÍMITE – CUARTO PERIODO:</strong> la <strong>exposición</strong> y el <strong>trabajo escrito</strong> deben realizarse <strong>ANTES DEL CIERRE DEL CUARTO PERIODO</strong>, en la fecha acordada previamente con el docente: ____/____/2026. Si no se realizan en esa fecha, <strong>NO SE NIVELA LA MATERIA</strong>.
       </div>`;

  return `
    <div class="nivelacion-box">
      <h3>⚖️ REQUISITO OBLIGATORIO PARA NIVELAR LA MATERIA</h3>
      <p>Para <strong>nivelar la asignatura</strong> no basta con entregar el trabajo escrito: el estudiante debe realizar además una <strong>exposición de 10 minutos</strong> sobre el trabajo realizado, apoyada en una <strong>cartelera o en una presentación digital</strong>.</p>

      <h4>1. ¿Qué se evalúa en la exposición?</h4>
      <ul>
        <li><strong>Conocimiento y dominio del tema:</strong> que el estudiante explique con sus propias palabras los conceptos, los procedimientos y los resultados de su trabajo, y que responda correctamente las preguntas del docente y de sus compañeros.</li>
        <li><strong>Calidad de la presentación:</strong> que la cartelera o las diapositivas estén bien elaboradas y organizadas (título, contenido claro, dibujos o imágenes alusivas, letra legible, ortografía correcta, colores y diseño agradable).</li>
        <li><strong>Expresión oral:</strong> tono de voz adecuado, seguridad, manejo del tiempo (10 minutos) y uso correcto del material de apoyo.</li>
      </ul>

      <h4>2. Procedimiento para presentar la nivelación</h4>
      <ol>
        <li>El estudiante <strong>presenta al docente el trabajo escrito</strong> completamente terminado.</li>
        <li>Lleva consigo su <strong>presentación</strong> (cartelera o presentación digital) ya preparada.</li>
        <li><strong>Solicita el favor al docente</strong> de presentar su nivelación ante el curso.</li>
        <li>Realiza la <strong>exposición de 10 minutos</strong> ante el curso y responde las preguntas.</li>
      </ol>

      ${fecha}

      <p><strong>Nota:</strong> la exposición y el trabajo escrito son requisitos <strong>indispensables</strong> para aprobar la nivelación. Si el estudiante no expone, la materia <strong>NO queda nivelada</strong>, aunque haya entregado el trabajo escrito.</p>
    </div>
  `;
}

function construirRecordatorioNivelacion(periodo){
  const tercero = String(periodo) === '3';

  const fechaTexto = tercero
    ? 'La exposición y el trabajo escrito del <strong>tercer periodo</strong> deben realizarse <strong>ANTES DEL 25 DE OCTUBRE</strong>; de no realizarse, <strong>NO SE NIVELA LA MATERIA</strong>.'
    : 'La exposición y el trabajo escrito del <strong>cuarto periodo</strong> deben realizarse <strong>antes del cierre del periodo</strong>, en la fecha acordada con el docente; de no realizarse, <strong>NO SE NIVELA LA MATERIA</strong>.';

  return `
    <div class="recordatorio-nivelacion">
      🔔 <strong>RECUERDE:</strong> para nivelar la materia debe <strong>entregar el trabajo escrito</strong> y realizar una <strong>exposición de 10 minutos</strong> en cartelera o digital, presentando el trabajo al docente y solicitándole el favor de exponer ante el curso. Se evaluará el <strong>conocimiento que el estudiante demuestre del tema</strong> y la <strong>calidad de la presentación</strong>. ${fechaTexto}
    </div>
  `;
}

function renderPlan(){
  const datos = PLANES[estado.materia].grados[estado.grado][estado.periodo];
  document.getElementById('visor-titulo').textContent = datos.titulo;
  document.getElementById('visor-subtitulo').textContent = datos.subtitulo;

  let html = datos.contenido;

  const bloqueNivelacion = construirBloqueNivelacion(estado.periodo);
  const recordatorioNivelacion = construirRecordatorioNivelacion(estado.periodo);

  /* Inserta el bloque de nivelación al inicio del plan (antes del marco teórico) */
  const marcaMarco = '<h2>1. MARCO TEÓRICO</h2>';
  if(html.indexOf(marcaMarco) !== -1){
    html = html.replace(marcaMarco, () => bloqueNivelacion + marcaMarco);
  } else {
    html = bloqueNivelacion + html;
  }

  /* Inserta el recordatorio al final, antes de las firmas */
  const marcaFirmas = '<div class="firmas">';
  if(html.indexOf(marcaFirmas) !== -1){
    html = html.replace(marcaFirmas, () => recordatorioNivelacion + marcaFirmas);
  } else {
    html = html + recordatorioNivelacion;
  }

  document.getElementById('visor-contenido').innerHTML = html;

  const bc = document.getElementById('breadcrumb');
  bc.innerHTML = `
    <span>${PLANES[estado.materia].nombre}</span> ›
    <span>${gradoEnLetras(estado.grado)} (${estado.grado}°)</span> ›
    <span class="actual">Periodo ${estado.periodo}</span>
  `;
}

function volver(destino){
  if(destino === 'materia'){
    estado.materia = null;
    estado.grado = null;
    estado.periodo = null;
    mostrar('materia');
  } else if(destino === 'grado'){
    estado.grado = null;
    estado.periodo = null;
    mostrar('grado');
  } else if(destino === 'periodo'){
    estado.periodo = null;
    mostrar('periodo');
  }
}

function reiniciar(){
  estado.materia = null;
  estado.grado = null;
  estado.periodo = null;
  mostrar('materia');
}

function imprimirPlan(){
  window.print();
}

document.addEventListener('DOMContentLoaded', () => {
  mostrar('materia');
});
</script>

</body>
</html>
