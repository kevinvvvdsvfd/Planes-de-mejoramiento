<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Planes de Mejoramiento – I.E. John F. Kennedy</title>
<style>
  :root{
    --azul:#123c69;
    --azul-osc:#0c2a4a;
    --azul-claro:#e8eef7;
    --dorado:#c9a227;
    --dorado-claro:#f5e6b3;
    --gris:#f4f6f9;
    --texto:#1a1a1a;
    --borde:#d0d7e2;
    --sombra:0 4px 16px rgba(18,60,105,.12);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:"Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size:15px;
    line-height:1.6;
    color:var(--texto);
    background:var(--gris);
    min-height:100vh;
  }

  header{
    background:linear-gradient(135deg,var(--azul) 0%,var(--azul-osc) 100%);
    color:#fff;
    padding:18px 20px;
    box-shadow:var(--sombra);
    position:sticky;
    top:0;
    z-index:100;
  }
  .header-inner{
    max-width:1100px;
    margin:0 auto;
    display:flex;
    align-items:center;
    gap:14px;
    flex-wrap:wrap;
  }
  .logo-circle{
    width:52px;height:52px;
    border:3px solid var(--dorado);
    border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:9px;text-align:center;
    color:#fff;line-height:1.1;
    flex-shrink:0;
  }
  .header-text h1{
    font-size:16px;
    font-weight:700;
    letter-spacing:.3px;
  }
  .header-text p{
    font-size:12px;
    color:#cdd9e8;
    margin-top:2px;
  }
  .header-badge{
    margin-left:auto;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.25);
    padding:6px 14px;
    border-radius:20px;
    font-size:12px;
    font-weight:600;
    color:var(--dorado-claro);
  }

  .hero{
    background:linear-gradient(135deg,var(--azul) 0%,#1c5a9e 100%);
    color:#fff;
    padding:48px 20px 56px;
    text-align:center;
    position:relative;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute;
    top:-40%;right:-10%;
    width:400px;height:400px;
    background:radial-gradient(circle,rgba(201,162,39,.18),transparent 70%);
    border-radius:50%;
  }
  .hero::after{
    content:"";
    position:absolute;
    bottom:-50%;left:-10%;
    width:350px;height:350px;
    background:radial-gradient(circle,rgba(255,255,255,.08),transparent 70%);
    border-radius:50%;
  }
  .hero-content{
    max-width:760px;
    margin:0 auto;
    position:relative;
    z-index:1;
  }
  .hero h2{
    font-size:30px;
    font-weight:800;
    margin-bottom:12px;
    letter-spacing:.3px;
  }
  .hero .sub{
    font-size:16px;
    color:#d7e3f2;
    margin-bottom:22px;
  }
  .docente-card{
    display:inline-flex;
    align-items:center;
    gap:12px;
    background:rgba(255,255,255,.1);
    border:1px solid rgba(255,255,255,.2);
    padding:10px 22px;
    border-radius:40px;
    backdrop-filter:blur(6px);
    font-size:14px;
  }
  .docente-card .avatar{
    width:38px;height:38px;
    background:var(--dorado);
    color:var(--azul-osc);
    border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:15px;
  }
  .docente-card strong{color:#fff;}
  .docente-card span{color:#c9d8ea;font-size:12.5px;display:block;}

  .container{
    max-width:1100px;
    margin:0 auto;
    padding:0 20px;
  }

  .seccion{
    padding:40px 0;
  }
  .seccion-titulo{
    text-align:center;
    margin-bottom:28px;
  }
  .seccion-titulo h3{
    font-size:22px;
    color:var(--azul);
    font-weight:800;
    margin-bottom:6px;
  }
  .seccion-titulo p{
    color:#5a6c80;
    font-size:14px;
  }
  .paso-num{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:26px;height:26px;
    background:var(--dorado);
    color:#222;
    border-radius:50%;
    font-weight:800;
    font-size:13px;
    margin-right:8px;
    vertical-align:middle;
  }

  .grid-materias{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
    max-width:820px;
    margin:0 auto;
  }
  .card-materia{
    background:#fff;
    border-radius:16px;
    padding:28px 24px;
    text-align:center;
    box-shadow:var(--sombra);
    cursor:pointer;
    transition:all .25s ease;
    border:2px solid transparent;
    position:relative;
    overflow:hidden;
  }
  .card-materia:hover{
    transform:translateY(-5px);
    border-color:var(--dorado);
    box-shadow:0 8px 26px rgba(18,60,105,.22);
  }
  .card-materia .icono{
    font-size:44px;
    margin-bottom:12px;
    display:block;
  }
  .card-materia h4{
    font-size:18px;
    color:var(--azul);
    font-weight:800;
    margin-bottom:6px;
  }
  .card-materia p{
    font-size:13px;
    color:#6b7c91;
  }

  .grid-grados{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(130px,1fr));
    gap:14px;
    max-width:780px;
    margin:0 auto;
  }
  .btn-grado{
    background:#fff;
    border:2px solid var(--borde);
    border-radius:12px;
    padding:18px 10px;
    text-align:center;
    cursor:pointer;
    transition:all .2s ease;
    font-weight:700;
    color:var(--azul);
    font-size:16px;
    box-shadow:0 2px 8px rgba(0,0,0,.05);
  }
  .btn-grado:hover{
    border-color:var(--dorado);
    background:var(--azul-claro);
    transform:translateY(-3px);
  }
  .btn-grado .sub{
    display:block;
    font-size:11px;
    color:#7a8a9e;
    font-weight:500;
    margin-top:3px;
  }

  .grid-periodos{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:16px;
    max-width:560px;
    margin:0 auto;
  }
  .btn-periodo{
    background:#fff;
    border:2px solid var(--borde);
    border-radius:14px;
    padding:22px 16px;
    text-align:center;
    cursor:pointer;
    transition:all .2s ease;
    box-shadow:0 2px 8px rgba(0,0,0,.05);
  }
  .btn-periodo:hover{
    border-color:var(--dorado);
    background:var(--azul-claro);
    transform:translateY(-3px);
  }
  .btn-periodo .num{
    font-size:30px;
    font-weight:900;
    color:var(--azul);
    line-height:1;
    display:block;
    margin-bottom:6px;
  }
  .btn-periodo .nom{
    font-size:13px;
    color:#6b7c91;
    font-weight:600;
  }

  .navegacion{
    display:flex;
    justify-content:center;
    gap:12px;
    margin-top:28px;
    flex-wrap:wrap;
  }
  .btn-nav{
    background:var(--azul);
    color:#fff;
    border:none;
    padding:12px 26px;
    border-radius:30px;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    transition:all .2s ease;
    box-shadow:0 3px 10px rgba(18,60,105,.25);
  }
  .btn-nav:hover{background:#1c5a9e;transform:translateY(-2px);}
  .btn-nav.secundario{
    background:#fff;
    color:var(--azul);
    border:2px solid var(--azul);
    box-shadow:none;
  }
  .btn-nav.secundario:hover{background:var(--azul-claro);}

  .visor{
    background:#fff;
    border-radius:16px;
    box-shadow:var(--sombra);
    overflow:hidden;
    margin-bottom:40px;
  }
  .visor-header{
    background:linear-gradient(135deg,var(--azul) 0%,var(--azul-osc) 100%);
    color:#fff;
    padding:20px 26px;
    display:flex;
    align-items:center;
    gap:14px;
    flex-wrap:wrap;
  }
  .visor-header .info{
    flex:1;
    min-width:200px;
  }
  .visor-header h3{
    font-size:18px;
    font-weight:800;
    margin-bottom:3px;
  }
  .visor-header p{
    font-size:12.5px;
    color:#c9d8ea;
  }
  .visor-header .acciones{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
  }
  .btn-accion{
    background:rgba(255,255,255,.15);
    border:1px solid rgba(255,255,255,.3);
    color:#fff;
    padding:9px 16px;
    border-radius:8px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    transition:all .2s ease;
    white-space:nowrap;
  }
  .btn-accion:hover{background:rgba(255,255,255,.28);}
  .btn-accion.dorado{
    background:var(--dorado);
    border-color:var(--dorado);
    color:#222;
  }
  .btn-accion.dorado:hover{background:#dbb63a;}

  .visor-body{
    padding:32px 36px;
    font-size:14.5px;
    line-height:1.7;
    color:#1f2933;
  }
  .visor-body h1{
    font-size:22px;
    color:var(--azul);
    text-align:center;
    margin:20px 0 6px;
    letter-spacing:.3px;
  }
  .visor-body h2{
    font-size:17px;
    color:#fff;
    background:var(--azul);
    padding:8px 14px;
    border-radius:6px;
    margin:28px 0 12px;
    border-left:6px solid var(--dorado);
  }
  .visor-body h3{
    font-size:15.5px;
    color:var(--azul);
    margin:18px 0 8px;
    border-bottom:2px solid var(--dorado);
    padding-bottom:3px;
  }
  .visor-body h4{
    font-size:14.5px;
    color:#2c3e50;
    margin:14px 0 6px;
  }
  .visor-body p{margin:8px 0;text-align:justify;}
  .visor-body ul,.visor-body ol{margin:8px 0 8px 24px;}
  .visor-body li{margin:5px 0;text-align:justify;}
  .visor-body .destacado{
    background:var(--azul-claro);
    border-left:5px solid var(--azul);
    padding:12px 16px;
    border-radius:0 8px 8px 0;
    margin:14px 0;
  }
  .visor-body .alerta{
    background:#fff8e6;
    border:2px dashed var(--dorado);
    padding:14px 18px;
    border-radius:8px;
    margin:16px 0;
  }
  .visor-body .alerta strong{color:#8a6d0b;}
  .visor-body .formato-entrega{
    background:linear-gradient(135deg,#fff8e6 0%,#fef3cd 100%);
    border:2px solid var(--dorado);
    border-radius:10px;
    padding:16px 20px;
    margin:18px 0;
  }
  .visor-body .formato-entrega h4{
    color:#8a6d0b;
    font-size:15px;
    margin-bottom:10px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .visor-body .formato-entrega h4::before{
    content:"📝";
    font-size:20px;
  }
  .visor-body .formato-entrega ul{
    margin:6px 0 0 20px;
  }
  .visor-body .formato-entrega li{
    margin:4px 0;
    font-size:14px;
  }
  .visor-body .formula{
    text-align:center;
    font-family:"Cambria Math","Times New Roman",serif;
    font-size:16px;
    background:var(--gris);
    border:1px solid var(--borde);
    border-radius:8px;
    padding:12px;
    margin:12px 0;
    font-weight:700;
    color:var(--azul);
  }
  .visor-body table{
    width:100%;
    border-collapse:collapse;
    font-size:13px;
    margin:12px 0;
  }
  .visor-body table th,.visor-body table td{
    border:1px solid var(--borde);
    padding:8px 10px;
    vertical-align:top;
  }
  .visor-body table th{
    background:var(--azul);
    color:#fff;
    font-weight:700;
    text-align:center;
    font-size:12.5px;
  }
  .visor-body table td{background:#fff;}
  .visor-body table tr:nth-child(even) td{background:#f8fafd;}
  .visor-body .actividad{
    background:#fafbfd;
    border:1px solid var(--borde);
    border-left:5px solid var(--dorado);
    padding:16px 20px;
    border-radius:0 10px 10px 0;
    margin:18px 0;
  }
  .visor-body .actividad .titulo-act{
    font-weight:800;
    color:var(--azul);
    display:block;
    margin-bottom:8px;
    font-size:15px;
    padding-bottom:5px;
    border-bottom:1px dashed var(--borde);
  }
  .visor-body .actividad ol{
    counter-reset:item;
    list-style:none;
    margin-left:0;
  }
  .visor-body .actividad ol > li{
    counter-increment:item;
    position:relative;
    padding-left:30px;
    margin:8px 0;
  }
  .visor-body .actividad ol > li::before{
    content:counter(item);
    position:absolute;
    left:0;
    top:2px;
    width:22px;height:22px;
    background:var(--azul);
    color:#fff;
    border-radius:50%;
    font-size:11px;
    font-weight:700;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .visor-body .actividad ul{
    margin-left:20px;
    margin-top:5px;
    margin-bottom:5px;
  }
  .visor-body .actividad ul li{
    list-style:disc;
    padding-left:0;
    margin:3px 0;
  }
  .visor-body .actividad ul li::before{content:none;}
  .visor-body .firmas{
    display:flex;
    justify-content:space-between;
    gap:30px;
    margin-top:36px;
    flex-wrap:wrap;
  }
  .visor-body .firma{
    flex:1;
    min-width:200px;
    border-top:1.5px solid #333;
    text-align:center;
    padding-top:8px;
    font-size:12.5px;
    color:#444;
  }
  .visor-body .pie{
    margin-top:28px;
    border-top:1px solid var(--borde);
    padding-top:10px;
    text-align:center;
    font-size:11.5px;
    color:#7a8a9e;
  }
  .visor-body .nota-advertencia{
    background:#fdecea;
    border-left:5px solid #c0392b;
    padding:12px 16px;
    border-radius:0 8px 8px 0;
    margin:14px 0;
    font-size:13.5px;
  }
  .visor-body .nota-advertencia strong{color:#c0392b;}
  .visor-body .reflexion-box{
    background:#e8f5e9;
    border-left:5px solid #2e7d32;
    padding:12px 16px;
    border-radius:0 8px 8px 0;
    margin:14px 0;
    font-size:13.5px;
  }
  .visor-body .reflexion-box strong{color:#2e7d32;}

  /* ===== BLOQUE DE NIVELACIÓN (EXPOSICIÓN) ===== */
  .visor-body .nivelacion-box{
    background:linear-gradient(135deg,#eef4ff 0%,#e2ecfb 100%);
    border:2px solid var(--azul);
    border-left:8px solid var(--dorado);
    border-radius:10px;
    padding:18px 22px;
    margin:20px 0;
  }
  .visor-body .nivelacion-box h3{
    color:var(--azul);
    font-size:16px;
    margin:0 0 10px;
    border-bottom:2px solid var(--dorado);
    padding-bottom:6px;
  }
  .visor-body .nivelacion-box h4{
    color:var(--azul-osc);
    font-size:14.5px;
    margin:14px 0 6px;
  }
  .visor-body .nivelacion-box ul,
  .visor-body .nivelacion-box ol{margin:6px 0 6px 22px;}
  .visor-body .nivelacion-box li{margin:5px 0;text-align:justify;}
  .visor-body .nivelacion-box p{margin:8px 0;text-align:justify;}
  .visor-body .nivelacion-box .fecha-limite{
    background:#fdecea;
    border:2px solid #c0392b;
    border-radius:8px;
    padding:12px 16px;
    margin:16px 0 8px;
    color:#8b1f14;
    font-size:14px;
    text-align:center;
  }
  .visor-body .recordatorio-nivelacion{
    background:#fff3cd;
    border-left:5px solid var(--dorado);
    border-radius:0 8px 8px 0;
    padding:12px 16px;
    margin:16px 0;
    font-size:13.5px;
    text-align:justify;
  }

  footer{
    background:var(--azul-osc);
    color:#c9d8ea;
    padding:36px 20px 28px;
    text-align:center;
    font-size:13px;
    margin-top:20px;
  }
  footer .footer-inner{
    max-width:800px;
    margin:0 auto;
  }
  footer .escudo{
    font-size:15px;
    font-weight:800;
    color:var(--dorado);
    margin-bottom:8px;
    letter-spacing:.5px;
  }
  footer p{margin:4px 0;}
  footer a{color:var(--dorado-claro);text-decoration:none;}
  footer a:hover{text-decoration:underline;}
  footer .copyright{
    margin-top:16px;
    padding-top:14px;
    border-top:1px solid rgba(255,255,255,.12);
    font-size:11.5px;
    color:#8fa3ba;
  }

  .oculto{display:none !important;}
  .fade-in{animation:fadeIn .35s ease;}
  @keyframes fadeIn{
    from{opacity:0;transform:translateY(10px);}
    to{opacity:1;transform:translateY(0);}
  }
  .breadcrumb{
    display:flex;
    align-items:center;
    gap:6px;
    font-size:12.5px;
    color:#7a8a9e;
    margin-bottom:16px;
    flex-wrap:wrap;
    justify-content:center;
  }
  .breadcrumb span.actual{color:var(--azul);font-weight:700;}

  @page{size:A4;margin:12mm;}
  @media print{
    body{background:#fff;font-size:11pt;}
    header,footer,.hero,.no-print,.visor-header .acciones,.breadcrumb,.navegacion{display:none !important;}
    .visor{box-shadow:none;border-radius:0;margin:0;}
    .visor-body{padding:0;}
    .visor-body h2,.visor-body .destacado,.visor-body .alerta,.visor-body .formula,
    .visor-body table th,.visor-body .actividad,.visor-body .formato-entrega,
    .visor-body .nota-advertencia,.visor-body .reflexion-box,
    .visor-body .nivelacion-box,.visor-body .nivelacion-box .fecha-limite,
    .visor-body .recordatorio-nivelacion,
    .visor-body .actividad ol > li::before{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    .visor-body h2{page-break-after:avoid;}
    .visor-body .actividad{page-break-inside:avoid;}
    .visor-body table{page-break-inside:avoid;}
    .visor-body .nivelacion-box{page-break-inside:avoid;}
  }

  @media(max-width:640px){
    .hero h2{font-size:22px;}
    .hero .sub{font-size:14px;}
    .visor-body{padding:20px 16px;}
    .visor-body h1{font-size:18px;}
    .visor-body h2{font-size:15px;}
    .header-badge{display:none;}
    .docente-card{padding:8px 16px;font-size:12.5px;}
    .docente-card .avatar{width:32px;height:32px;font-size:13px;}
    .visor-body .actividad ol > li{padding-left:26px;}
    .visor-body .actividad ol > li::before{width:20px;height:20px;font-size:10px;}
  }
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="logo-circle">I.E.<br>JFK</div>
    <div class="header-text">
      <h1>Institución Educativa John F. Kennedy</h1>
      <p>San Juanito – Meta · Planes de Mejoramiento 2026</p>
    </div>
    <div class="header-badge">📚 Periodos 3 y 4</div>
  </div>
</header>

<section class="hero">
  <div class="hero-content">
    <h2>Planes de Mejoramiento Académico</h2>
    <p class="sub">Selecciona tu área, grado y periodo para consultar, desarrollar y descargar tu plan</p>
    <div class="docente-card">
      <div class="avatar">KC</div>
      <div>
        <strong>Kevin Daniel Castillo Gómez</strong>
        <span>Docente – Tecnología e Informática y Matemáticas</span>
      </div>
    </div>
  </div>
</section>

<main class="container">

  <section class="seccion" id="paso-materia">
    <div class="seccion-titulo">
      <h3><span class="paso-num">1</span>Elige tu área</h3>
      <p>Selecciona la asignatura para la cual necesitas el plan de mejoramiento</p>
    </div>
    <div class="grid-materias">
      <div class="card-materia" onclick="seleccionarMateria('tecnologia')">
        <span class="icono">💻</span>
        <h4>Tecnología e Informática</h4>
        <p>Grados 6° a 11° · Periodos 3 y 4</p>
      </div>
      <div class="card-materia" onclick="seleccionarMateria('matematicas')">
        <span class="icono">📐</span>
        <h4>Matemáticas</h4>
        <p>Grados 6° y 7° · Periodos 3 y 4</p>
      </div>
    </div>
  </section>

  <section class="seccion oculto" id="paso-grado">
    <div class="seccion-titulo">
      <h3><span class="paso-num">2</span>Elige tu grado</h3>
      <p id="grado-subtitulo">Selecciona el grado al que perteneces</p>
    </div>
